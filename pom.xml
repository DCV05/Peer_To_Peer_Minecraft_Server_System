<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>Peer_To_Peer_Minecraft_Server_System</groupId>
  <artifactId>Endershare</artifactId>
  <version>1.8.1</version>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- Repo de GitHub cuyas releases consulta el update checker; cada fork pone el suyo al compilar -->
    <p2pmss.releasesRepo>DCV05/Peer_To_Peer_Minecraft_Server_System</p2pmss.releasesRepo>
    <!-- Los E2E con server de Minecraft REAL (tag e2e-mc) no corren en el mvn test
         rapido: se activan con el perfil e2e-mc (job propio del CI) -->
    <p2pmss.excludedTestGroups>e2e-mc,e2e-real</p2pmss.excludedTestGroups>
    <p2pmss.testGroups></p2pmss.testGroups>
  </properties>
  <repositories>
    <repository>
      <!-- MCProtocolLib (bot de jugador para los tests E2E) se publica aqui -->
      <id>opencollab</id>
      <url>https://repo.opencollab.dev/main/</url>
    </repository>
  </repositories>
  <dependencies>
	<dependency>
	  <groupId>org.junit.jupiter</groupId>
	  <artifactId>junit-jupiter</artifactId>
	  <version>5.10.3</version>
	  <scope>test</scope>
	</dependency>
	<dependency>
	  <!-- Jugador-bot de los tests E2E: entra a un server real por protocolo.
	       La version esta pineada al protocolo de Minecraft 1.21.7, que es la
	       version que instala MinecraftServerE2ETest -->
	  <groupId>org.geysermc.mcprotocollib</groupId>
	  <artifactId>protocol</artifactId>
	  <version>1.21.7-1</version>
	  <scope>test</scope>
	</dependency>
	<dependency>
	  <groupId>org.eclipse.jgit</groupId>
	  <artifactId>org.eclipse.jgit</artifactId>
	  <version>6.8.0.202311291450-r</version>
	</dependency>
	<dependency>
	    <groupId>com.formdev</groupId>
	    <artifactId>flatlaf</artifactId>
	    <version>3.5</version>
	</dependency>
    <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>2.17.2</version>
    </dependency>
    
    <!-- Google Drive API -->
    <dependency>
        <groupId>com.google.apis</groupId>
        <artifactId>google-api-services-drive</artifactId>
        <version>v3-rev20230822-2.0.0</version>
    </dependency>

    <!-- OAuth and HTTP -->
    <dependency>
        <groupId>com.google.api-client</groupId>
        <artifactId>google-api-client</artifactId>
        <version>2.2.0</version>
    </dependency>
    <dependency>
        <groupId>com.google.oauth-client</groupId>
        <artifactId>google-oauth-client-jetty</artifactId>
        <version>1.34.1</version>
    </dependency>
    <dependency>
	  <groupId>com.google.apis</groupId>
	  <artifactId>google-api-services-oauth2</artifactId>
	  <version>v2-rev20200213-2.0.0</version>
	</dependency>
  </dependencies>
  <build>
    <sourceDirectory>src</sourceDirectory>
	<testSourceDirectory>tests</testSourceDirectory>
  	<resources>
	    <resource>
	      <directory>src/resources</directory>
	      <includes>
	        <include>**/*</include>
	      </includes>
	      <excludes>
	        <exclude>p2pmss-update.properties</exclude>
	      </excludes>
	    </resource>
	    <resource>
	      <directory>src/resources</directory>
	      <includes>
	        <include>p2pmss-update.properties</include>
	      </includes>
	      <filtering>true</filtering>
	    </resource>
  	</resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <excludedGroups>${p2pmss.excludedTestGroups}</excludedGroups>
          <groups>${p2pmss.testGroups}</groups>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>21</release>
        </configuration>
      </plugin>

      <plugin>
	    <groupId>org.apache.maven.plugins</groupId>
	    <artifactId>maven-shade-plugin</artifactId>
	    <version>3.5.0</version>
	    <executions>
	        <execution>
	            <phase>package</phase>
	            <goals>
	                <goal>shade</goal>
	            </goals>
	            <configuration>
	                <transformers>
	                    <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
	                        <mainClass>view.MainFrame</mainClass>
	                    </transformer>
	                </transformers>
	                <filters>
					  <filter>
					    <artifact>*:*</artifact>
					    <excludes>
					      <exclude>META-INF/*.SF</exclude>
					      <exclude>META-INF/*.DSA</exclude>
					      <exclude>META-INF/*.RSA</exclude>
					    </excludes>
					  </filter>
					</filters>
	            </configuration>
	        </execution>
	    </executions>
	  </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>2.43.0</version>
        <configuration>
          <java>
            <includes>
              <include>src/**/*.java</include>
              <include>tests/**/*.java</include>
            </includes>
            <eclipse>
              <file>${project.basedir}/style/eclipse-format.xml</file>
            </eclipse>
          </java>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <!-- mvn -Pe2e-mc test: SOLO los E2E con server de Minecraft real -->
      <id>e2e-mc</id>
      <properties>
        <p2pmss.excludedTestGroups></p2pmss.excludedTestGroups>
        <p2pmss.testGroups>e2e-mc</p2pmss.testGroups>
      </properties>
    </profile>
  </profiles>
</project>
